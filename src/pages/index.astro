---
const title = 'SPCTIME';
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#050608" />
    <meta name="description" content="SPCTIME" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="SPCTIME" />
    <meta property="og:description" content="SPCTIME" />
    <meta property="og:url" content="https://spctime.ai/" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="canonical" href="https://spctime.ai/" />
    <title>{title}</title>
    <style is:global>
      :root { background: #050608; color: #e9eaf0; font-family: Arial, Helvetica, sans-serif; }
      * { box-sizing: border-box; }
      html, body { width: 100%; min-height: 100%; margin: 0; overflow: hidden; }
      body { overscroll-behavior: none; }
      #stage { position: fixed; inset: 0; isolation: isolate; overflow: hidden; touch-action: none; cursor: grab; }
      #stage:active { cursor: grabbing; }
      #scene { display: block; width: 100%; height: 100%; }
      #type-layer { position: absolute; inset: 0; display: block; width: 100%; height: 100%; pointer-events: none; filter: blur(5px); }
      .grain { position: absolute; inset: 0; pointer-events: none; opacity: .07; mix-blend-mode: screen;
        background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.35'/%3E%3C/svg%3E"); }
      #fallback { position: absolute; inset: 0; display: none; align-items: center; justify-content: center;
        font-size: clamp(40px, 10vw, 176px); letter-spacing: -.065em; font-weight: 900; color: #e9eaf0; filter: blur(4.6px); }
      .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
      @media (prefers-reduced-motion: reduce) { #stage { cursor: default; } }
    </style>
  </head>
  <body>
    <main id="stage" aria-label="SPCTIME, an interactive typographic experience">
      <canvas id="scene" aria-hidden="true"></canvas>
      <canvas id="type-layer" aria-hidden="true"></canvas>
      <div class="grain" aria-hidden="true"></div>
      <h1 id="fallback">SPCTIME</h1>
      <p class="sr-only">SPCTIME. Drag or tap the letters to move them. Press Space to scatter them; press Escape to reset. Animation respects your reduced motion setting.</p>
    </main>
    <script>
      import '../scripts/letters.js';
    </script>
  </body>
</html>
